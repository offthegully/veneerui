{
  "name": "veneerui",
  "version": "0.1.4",
  "description": "CLI to add Veneer UI theming to an existing React + Tailwind v4 app (init, add, doctor, migrate). For a new app, use `npm create veneerui`.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offthegully/veneerui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://veneerui.dev",
  "type": "module",
  "bin": {
    "veneerui": "./dist/cli.js"
  },
  "files": [
    "dist",
    "registry",
    "assets"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@veneerui/lint-core": "*",
    "@veneerui/setup-core": "*",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.7"
  }
}
