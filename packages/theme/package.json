{
  "name": "@offthegully/veneerui",
  "version": "0.1.1",
  "description": "User-extensible Tailwind v4 theming runtime — tokens, provider, validation, and import pipeline.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offthegully/veneerui.git",
    "directory": "packages/theme"
  },
  "homepage": "https://veneerui.dev",
  "type": "module",
  "sideEffects": ["*.css"],
  "files": [
    "dist",
    "tokens.generated.css",
    "theme-v1.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "default": "./dist/themes.js"
    },
    "./tokens.css": "./tokens.generated.css",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./theme-v1.json": "./theme-v1.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "css-tree": "^3.2.1"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4",
    "vite": "^8"
  },
  "peerDependenciesMeta": {
    "tailwindcss": { "optional": true },
    "vite": { "optional": true }
  },
  "devDependencies": {
    "@types/css-tree": "^2.3.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7"
  }
}
