{
  "$schema": "https://veneerui.dev/schemas/theme-v1.json",
  "name": "Windows 95",
  "description": "Battleship-gray system UI: chiseled outset bevels instead of soft shadows, hard square corners, the navy→cyan title-bar gradient, a teal accent, the system font, and zero transition time. Depth comes from light and dark edges, not blur.",
  "author": {
    "id": "veneer",
    "name": "Veneer Team"
  },
  "version": "1.0.0",
  "schemaVersion": 1,
  "tags": [
    "retro",
    "light",
    "system",
    "bold"
  ],
  "license": "MIT",
  "tokens": {
    "color-primary": "#000080",
    "color-primary-hover": "#1084d0",
    "color-primary-active": "#00006e",
    "color-primary-subtle": "#d6dff0",
    "color-accent": "#008080",
    "color-accent-hover": "#009b9b",
    "color-accent-active": "#006666",
    "color-success": "#008000",
    "color-success-hover": "#249224",
    "color-success-active": "#47a447",
    "color-success-subtle": "#dbeddb",
    "color-warning": "#aa6b00",
    "color-warning-hover": "#b68024",
    "color-warning-active": "#c29447",
    "color-warning-subtle": "#f3eadb",
    "color-danger": "#aa0000",
    "color-danger-hover": "#b62424",
    "color-danger-active": "#c24747",
    "color-danger-subtle": "#f3dbdb",
    "color-info": "#000080",
    "color-info-hover": "#242492",
    "color-info-active": "#4747a4",
    "color-info-subtle": "#dbdbed",
    "color-focus-ring": "#000000",
    "color-surface": "#c0c0c0",
    "color-surface-raised": "#c0c0c0",
    "color-surface-sunken": "#a8a8a8",
    "color-surface-overlay": "#c0c0c0",
    "color-surface-inverse": "#000080",
    "color-overlay-backdrop": "rgb(0 0 128 / 0.35)",
    "color-text": "#000000",
    "color-text-muted": "#2e2e2e",
    "color-text-subtle": "#565656",
    "color-text-inverse": "#ffffff",
    "color-text-on-primary": "#ffffff",
    "color-text-on-accent": "#ffffff",
    "color-text-on-success": "#ffffff",
    "color-text-on-info": "#ffffff",
    "color-border": "#808080",
    "color-border-strong": "#000000",
    "color-border-subtle": "#dfdfdf",
    "border-width-thin": "1px",
    "border-width-default": "2px",
    "border-width-thick": "3px",
    "radius-none": "0px",
    "radius-xs": "0px",
    "radius-sm": "0px",
    "radius-md": "0px",
    "radius-lg": "0px",
    "radius-xl": "0px",
    "radius-2xl": "0px",
    "radius-3xl": "0px",
    "radius-full": "0px",
    "shadow-2xs": "1px 1px 0 0 #808080",
    "shadow-sm": "-1px -1px 0 0 #ffffff, 1px 1px 0 0 #404040",
    "shadow-md": "-1px -1px 0 0 #ffffff, 2px 2px 0 0 #404040",
    "shadow-lg": "-2px -2px 0 0 #ffffff, 4px 4px 0 0 #404040",
    "shadow-xl": "-2px -2px 0 0 #ffffff, 5px 5px 0 0 rgb(0 0 0 / 0.4)",
    "shadow-2xl": "-2px -2px 0 0 #ffffff, 7px 7px 0 0 rgb(0 0 0 / 0.45)",
    "shadow-card": "-1px -1px 0 0 #ffffff, 2px 2px 0 0 #404040",
    "font-sans": "'MS Sans Serif', system-ui, sans-serif",
    "font-display": "'MS Sans Serif', system-ui, sans-serif",
    "font-weight-normal": "400",
    "font-weight-medium": "700",
    "font-weight-semibold": "700",
    "font-weight-bold": "700",
    "font-weight-extrabold": "700",
    "font-weight-black": "700",
    "tracking-tighter": "-0.01em",
    "tracking-tight": "0em",
    "tracking-normal": "0em",
    "gradient-primary": "linear-gradient(90deg, #000080 0%, #1084d0 100%)",
    "gradient-accent": "linear-gradient(90deg, #008080 0%, #00b3b3 100%)",
    "gradient-text": "linear-gradient(90deg, #000080 0%, #1084d0 100%)",
    "gradient-surface": "linear-gradient(180deg, #c0c0c0 0%, #b4b4b4 100%)",
    "duration-fast": "0",
    "duration-default": "0",
    "duration-slow": "0",
    "ease-default": "linear",
    "ease-snappy": "linear"
  }
}
