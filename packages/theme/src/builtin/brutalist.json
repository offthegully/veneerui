    "shadow-md": "4px 4px 0 0 #000000",
    "shadow-lg": "8px 8px 0 0 #000000",
    "shadow-xl": "12px 12px 0 0 #000000",
    "shadow-2xl": "16px 16px 0 0 #000000",
    "shadow-card": "4px 4px 0 0 #000000",
    "inset-shadow-md": "inset 3px 3px 0 0 #000000",
    "text-shadow-sm": "2px 2px 0 #000000",
    "text-shadow-md": "3px 3px 0 #000000",
    "text-shadow-lg": "4px 4px 0 #000000",
    "text-shadow-glow": "4px 4px 0 #00e5ff",
    "drop-shadow-sm": "2px 2px 0 #000000",
    "drop-shadow-md": "3px 3px 0 #000000",
    "drop-shadow-lg": "5px 5px 0 #000000",
