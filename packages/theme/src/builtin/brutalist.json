{
  "$schema": "https://veneerui.dev/schemas/theme-v1.json",
  "name": "Brutalist",
  "description": "Thick black borders, zero radii, hard offset shadows with no blur, a heavy display face, tight tracking, and snappy motion. Loud on purpose, and demonstrates the schema's full range.",
  "author": {
    "id": "veneer",
    "name": "Veneer Team"
  },
  "version": "1.1.0",
  "schemaVersion": 1,
  "tags": [
    "bold",
    "high-contrast",
    "retro"
  ],
  "license": "MIT",
  "tokens": {
    "color-primary": "#ff4d00",
    "color-primary-hover": "#e64500",
    "color-primary-active": "#cc3d00",
    "color-primary-subtle": "#ffe8dc",
    "color-accent": "#00e5ff",
    "color-accent-hover": "#00c4d9",
    "color-success": "#00c853",
    "color-success-hover": "#00ac47",
    "color-success-active": "#00903c",
    "color-success-subtle": "#dbf7e7",
    "color-warning": "#ffd600",
    "color-warning-hover": "#dbb800",
    "color-warning-active": "#b89a00",
    "color-warning-subtle": "#fff9db",
    "color-danger": "#ff1744",
    "color-danger-hover": "#db143a",
    "color-danger-active": "#b81131",
    "color-danger-subtle": "#ffdfe5",
