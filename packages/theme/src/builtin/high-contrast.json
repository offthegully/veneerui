    "shadow-sm": "0 0 0 2px #000000",
    "shadow-md": "0 0 0 2px #000000",
    "shadow-lg": "0 0 0 3px #000000",
    "shadow-xl": "0 0 0 3px #000000",
    "shadow-2xl": "0 0 0 3px #000000",
    "shadow-card": "0 0 0 2px #000000",
    "inset-shadow-md": "inset 0 0 0 2px #000000",
    "text-shadow-sm": "none",
    "text-shadow-md": "none",
    "text-shadow-lg": "none",
    "text-shadow-glow": "none",
    "text-base": "18px",
