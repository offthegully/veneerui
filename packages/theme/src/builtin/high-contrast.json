{
  "$schema": "https://veneerui.dev/schemas/theme-v1.json",
  "name": "High Contrast",
  "description": "An accessibility theme: pure black on white, 2px borders everywhere, sharp corners, enlarged text, and rings instead of soft shadows. Also proves border-width and radius are real theme axes.",
  "author": {
    "id": "veneer",
    "name": "Veneer Team"
  },
  "version": "1.1.0",
  "schemaVersion": 1,
  "tags": [
    "accessibility",
    "high-contrast",
    "light"
  ],
  "license": "MIT",
  "tokens": {
    "color-primary": "#0000ee",
    "color-primary-hover": "#0000cc",
    "color-primary-active": "#000099",
    "color-primary-subtle": "#e6e6ff",
    "color-accent": "#9900cc",
    "color-success": "#006600",
    "color-success-hover": "#005800",
    "color-success-active": "#004900",
    "color-success-subtle": "#dbeadb",
    "color-warning": "#a85400",
    "color-warning-hover": "#904800",
    "color-warning-active": "#793c00",
    "color-warning-subtle": "#f3e7db",
    "color-danger": "#cc0000",
    "color-danger-hover": "#af0000",
    "color-danger-active": "#930000",
    "color-danger-subtle": "#f8dbdb",
    "color-info": "#0000ee",
    "color-info-hover": "#0000cd",
    "color-info-active": "#0000ab",
    "color-info-subtle": "#dbdbfd",
    "color-focus-ring": "#000000",
    "color-surface": "#ffffff",
    "color-surface-raised": "#ffffff",
    "color-surface-sunken": "#ffffff",
    "color-surface-overlay": "#ffffff",
    "color-surface-inverse": "#000000",
    "color-overlay-backdrop": "rgb(0 0 0 / 0.8)",
    "color-text": "#000000",
    "color-text-muted": "#000000",
    "color-text-subtle": "#1a1a1a",
    "color-text-inverse": "#ffffff",
    "color-text-on-primary": "#ffffff",
    "color-text-on-accent": "#ffffff",
    "color-text-on-success": "#ffffff",
    "color-text-on-warning": "#ffffff",
    "color-text-on-info": "#ffffff",
    "color-border": "#000000",
    "color-border-strong": "#000000",
    "color-border-subtle": "#000000",
    "border-width-thin": "2px",
    "border-width-default": "2px",
    "border-width-thick": "4px",
    "focus-ring-width": "3px",
    "radius-none": "0px",
    "radius-xs": "0px",
    "radius-sm": "0px",
    "radius-md": "0px",
