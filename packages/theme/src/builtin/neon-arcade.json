{
  "$schema": "https://veneerui.dev/schemas/theme-v1.json",
  "name": "Neon Arcade",
  "description": "Synthwave on near-black: a glowing neon grid floor under a violet horizon haze, hot-magenta and cyan tubes that bloom on every surface, vivid magenta->violet->cyan gradients, glowing text, and an Orbitron display face. Leans hard on the gradient set, layered glow shadows, and text-shadow-glow.",
  "author": {
    "id": "veneer",
    "name": "Veneer Team"
  },
  "version": "1.1.0",
  "schemaVersion": 1,
  "tags": [
    "dark",
    "neon",
    "retro",
    "synthwave"
  ],
  "license": "MIT",
  "tokens": {
    "color-primary": "#ff2bd6",
    "color-primary-hover": "#ff5ce0",
    "color-primary-active": "#e016bf",
    "color-primary-subtle": "rgb(255 43 214 / 0.18)",
    "color-accent": "#00f0ff",
    "color-accent-hover": "#5cf6ff",
    "color-accent-active": "#00c8d6",
    "color-success": "#39ff14",
    "color-success-hover": "#55ff35",
    "color-success-active": "#70ff56",
    "color-success-subtle": "rgb(57 255 20 / 0.16)",
    "color-warning": "#ffd000",
    "color-warning-hover": "#ffd724",
    "color-warning-active": "#ffdd47",
    "color-warning-subtle": "rgb(255 208 0 / 0.16)",
    "color-danger": "#ff3b6b",
    "color-danger-hover": "#ff5680",
    "color-danger-active": "#ff7294",
    "color-danger-subtle": "rgb(255 59 107 / 0.16)",
    "color-info": "#00f0ff",
    "color-info-hover": "#24f2ff",
    "color-info-active": "#47f4ff",
    "color-info-subtle": "rgb(0 240 255 / 0.16)",
    "color-focus-ring": "#00f0ff",
    "color-surface": "#0a0118",
    "color-surface-raised": "#180b32",
    "color-surface-sunken": "#0d0322",
    "color-surface-overlay": "rgb(24 11 50 / 0.92)",
    "color-surface-inverse": "#f5e6ff",
    "color-overlay-backdrop": "rgb(5 1 15 / 0.72)",
    "color-text": "#f5e6ff",
    "color-text-muted": "rgb(245 230 255 / 0.7)",
    "color-text-subtle": "rgb(245 230 255 / 0.45)",
    "color-text-inverse": "#0a0118",
    "color-text-on-primary": "#0a0118",
    "color-text-on-danger": "#111827",
    "color-border": "rgb(255 43 214 / 0.55)",
    "color-border-strong": "rgb(0 240 255 / 0.7)",
    "color-border-subtle": "rgb(0 240 255 / 0.12)",
    "border-width-default": "1.5px",
    "radius-md": "10px",
    "radius-lg": "14px",
    "radius-xl": "20px",
    "shadow-sm": "0 0 0 1px rgb(255 43 214 / 0.35), 0 0 8px rgb(255 43 214 / 0.28)",
    "shadow-md": "0 0 0 1px rgb(255 43 214 / 0.45), 0 0 16px rgb(255 43 214 / 0.38), 0 8px 24px rgb(0 0 0 / 0.55)",
    "shadow-lg": "0 0 0 1px rgb(0 240 255 / 0.5), 0 0 26px rgb(0 240 255 / 0.45), 0 16px 40px rgb(0 0 0 / 0.6)",
    "shadow-xl": "0 0 0 1px rgb(0 240 255 / 0.55), 0 0 48px rgb(255 43 214 / 0.5), 0 24px 64px rgb(0 0 0 / 0.72)",
    "shadow-card": "0 0 0 1px rgb(255 43 214 / 0.45), 0 0 18px rgb(255 43 214 / 0.32), 0 8px 24px rgb(0 0 0 / 0.55)",
    "shadow-glow": "0 0 28px rgb(255 43 214 / 0.7)",
    "inset-shadow-sm": "inset 0 0 12px rgb(0 240 255 / 0.18)",
    "inset-shadow-md": "inset 0 0 18px rgb(0 240 255 / 0.22)",
    "text-shadow-md": "0 0 6px rgb(255 43 214 / 0.6)",
    "text-shadow-lg": "0 0 10px rgb(255 43 214 / 0.75)",
    "text-shadow-glow": "0 0 8px rgb(0 240 255 / 0.95), 0 0 22px rgb(255 43 214 / 0.7)",
    "drop-shadow-lg": "0 0 16px rgb(0 240 255 / 0.55)",
    "gradient-primary": "linear-gradient(120deg, #ff2bd6 0%, #b14cff 48%, #00f0ff 100%)",
    "gradient-accent": "linear-gradient(120deg, #7c3aed 0%, #00f0ff 100%)",
    "gradient-surface": "repeating-linear-gradient(0deg, transparent 0 46px, rgb(0 240 255 / 0.11) 46px 48px), repeating-linear-gradient(90deg, transparent 0 46px, rgb(255 43 214 / 0.1) 46px 48px), radial-gradient(135% 95% at 50% -12%, rgb(124 58 237 / 0.48) 0%, rgb(124 58 237 / 0) 58%), linear-gradient(180deg, #1c0b3c 0%, #0a0118 58%, #06010f 100%)",
    "gradient-text": "linear-gradient(120deg, #ff2bd6 0%, #ff6ec7 32%, #00f0ff 100%)",
    "font-display": "'Orbitron Variable', 'Archivo Black', sans-serif",
    "font-weight-bold": "700",
    "font-weight-black": "900",
    "tracking-widest": "0.3em",
    "duration-default": "120",
    "ease-default": "cubic-bezier(0.2, 0, 0, 1)"
  }
}
