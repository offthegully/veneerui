{
  "$schema": "https://veneerui.dev/schemas/theme-v1.json",
  "name": "Brutalist",
  "description": "Thick black borders, zero radii, hard offset shadows with no blur, a heavy display face, tight tracking, and snappy linear motion. Loud on purpose.",
  "author": { "id": "veneer", "name": "Veneer Team" },
  "version": "1.0.0",
  "schemaVersion": 1,
  "tags": ["bold", "high-contrast", "retro"],
  "license": "MIT",
  "tokens": {
    "color-primary": "#ff4d00",
    "color-primary-hover": "#e64500",
    "color-primary-active": "#cc3d00",
    "color-primary-subtle": "#ffe8df",
    "color-accent": "#0000ff",
    "color-success": "#008000",
    "color-warning": "#ffaa00",
    "color-danger": "#ff0000",
    "color-info": "#0000ff",
    "color-focus-ring": "#000000",
    "color-surface": "#fffef5",
    "color-surface-raised": "#ffffff",
    "color-surface-sunken": "#f2f0e6",
    "color-surface-overlay": "#ffffff",
    "color-surface-inverse": "#000000",
    "color-text": "#000000",
    "color-text-muted": "#1a1a1a",
    "color-text-subtle": "#404040",
    "color-text-inverse": "#ffffff",
    "color-text-on-primary": "#ffffff",
    "color-border": "#000000",
    "color-border-strong": "#000000",
    "color-border-subtle": "#000000",
    "border-width-thin": "2px",
    "border-width-default": "3px",
    "border-width-thick": "6px",
    "radius-none": "0px",
    "radius-sm": "0px",
    "radius-md": "0px",
    "radius-lg": "0px",
    "radius-xl": "0px",
    "radius-2xl": "0px",
    "radius-full": "0px",
    "shadow-sm": "4px 4px 0 0 #000000",
    "shadow-md": "6px 6px 0 0 #000000",
    "shadow-lg": "8px 8px 0 0 #000000",
    "shadow-xl": "12px 12px 0 0 #000000",
    "shadow-card": "4px 4px 0 0 #000000",
    "font-sans": "'Inter Variable', system-ui, sans-serif",
    "font-display": "'Archivo Black', sans-serif",
    "font-weight-normal": "500",
    "font-weight-medium": "700",
    "font-weight-bold": "900",
    "font-weight-black": "900",
    "tracking-tight": "-0.04em",
    "tracking-normal": "-0.01em",
    "duration-fast": "60",
    "duration-default": "100",
    "duration-slow": "180",
    "ease-default": "linear",
    "ease-snappy": "linear"
  }
}
