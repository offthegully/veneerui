{
  "$schema": "https://veneer.app/schemas/theme-v1.json",
  "name": "Neumorphic",
  "description": "Soft UI: one low-contrast surface color everywhere, shape carved purely with paired light/dark shadows, big radii, slow smooth easing. The shadows do all the work.",
  "author": { "id": "veneer", "name": "Veneer Team" },
  "version": "1.0.0",
  "schemaVersion": 1,
  "tags": ["soft", "light", "tactile"],
  "license": "MIT",
  "tokens": {
    "color-primary": "#6d7cff",
    "color-primary-hover": "#5a6bff",
    "color-primary-active": "#4857e6",
    "color-primary-subtle": "#eaecff",
    "color-accent": "#ff7eb6",
    "color-success": "#3bc47e",
    "color-warning": "#f0a955",
    "color-danger": "#f0656f",
    "color-info": "#5aa9e6",
    "color-focus-ring": "#6d7cff",
    "color-surface": "#e0e5ec",
    "color-surface-raised": "#e0e5ec",
    "color-surface-sunken": "#d1d9e6",
    "color-surface-overlay": "#e6ebf2",
    "color-surface-inverse": "#2d3748",
    "color-text": "#4a5568",
    "color-text-muted": "#718096",
    "color-text-subtle": "#a0aec0",
    "color-text-inverse": "#ffffff",
    "color-text-on-primary": "#ffffff",
    "color-border": "#cbd2dc",
    "color-border-strong": "#b8c0cc",
    "color-border-subtle": "#e0e5ec",
    "radius-sm": "12px",
    "radius-md": "16px",
    "radius-lg": "24px",
    "radius-xl": "32px",
    "radius-2xl": "40px",
    "shadow-sm": "6px 6px 12px #c5c9cf, -6px -6px 12px #ffffff",
    "shadow-md": "8px 8px 16px #c5c9cf, -8px -8px 16px #ffffff",
    "shadow-lg": "12px 12px 24px #c5c9cf, -12px -12px 24px #ffffff",
    "shadow-card": "8px 8px 16px #c5c9cf, -8px -8px 16px #ffffff",
    "inset-shadow-sm": "inset 4px 4px 8px #c5c9cf, inset -4px -4px 8px #ffffff",
    "inset-shadow-lg": "inset 6px 6px 12px #c5c9cf, inset -6px -6px 12px #ffffff",
    "font-sans": "'Quicksand Variable', system-ui, sans-serif",
    "font-display": "'Quicksand Variable', system-ui, sans-serif",
    "duration-default": "300",
    "ease-default": "cubic-bezier(0.4, 0, 0.2, 1)",
    "ease-smooth": "cubic-bezier(0.65, 0, 0.35, 1)"
  }
}
