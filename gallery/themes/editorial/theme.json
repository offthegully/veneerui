{
  "$schema": "https://veneerui.dev/schemas/theme-v1.json",
  "name": "Editorial",
  "description": "A magazine feel: serif body, a high-contrast Fraunces display face, an enlarged type scale, generous spacing and leading, and a restrained warm-paper palette.",
  "author": { "id": "veneer", "name": "Veneer Team" },
  "version": "1.0.0",
  "schemaVersion": 1,
  "tags": ["light", "serif", "editorial"],
  "license": "MIT",
  "tokens": {
    "color-primary": "#9a3412",
    "color-primary-hover": "#7c2d12",
    "color-primary-active": "#6b2710",
    "color-primary-subtle": "#fef3e8",
    "color-accent": "#1e3a5f",
    "color-success": "#3f6212",
    "color-warning": "#a16207",
    "color-danger": "#b91c1c",
    "color-info": "#1e3a5f",
    "color-focus-ring": "#9a3412",
    "color-surface": "#faf7f0",
    "color-surface-raised": "#fffdf8",
    "color-surface-sunken": "#f0ebe0",
    "color-surface-overlay": "#fffdf8",
    "color-surface-inverse": "#1c1814",
    "color-text": "#1c1814",
    "color-text-muted": "#57534e",
    "color-text-subtle": "#a8a29e",
    "color-text-inverse": "#faf7f0",
    "color-text-on-primary": "#faf7f0",
    "color-border": "#e7e0d3",
    "color-border-strong": "#d6cdba",
    "color-border-subtle": "#f0ebe0",
    "radius-sm": "2px",
    "radius-md": "4px",
    "radius-lg": "6px",
    "shadow-sm": "0 1px 2px rgb(28 24 20 / 0.06)",
    "shadow-md": "0 4px 10px -2px rgb(28 24 20 / 0.1)",
    "shadow-card": "0 1px 2px rgb(28 24 20 / 0.08)",
    "font-sans": "'Source Serif 4 Variable', serif",
    "font-serif": "'Source Serif 4 Variable', serif",
    "font-display": "'Fraunces Variable', serif",
    "text-base": "18px",
    "text-lg": "20px",
    "text-xl": "24px",
    "text-2xl": "30px",
    "text-3xl": "40px",
    "text-4xl": "52px",
    "text-5xl": "64px",
    "text-6xl": "80px",
    "text-7xl": "96px",
    "text-8xl": "120px",
    "text-9xl": "160px",
    "font-weight-extrabold": "800",
    "leading-tight": "1.15",
    "leading-normal": "1.6",
    "leading-relaxed": "1.85",
    "leading-loose": "2",
    "tracking-tighter": "-0.04em",
    "tracking-tight": "-0.02em",
    "tracking-widest": "0.25em",
    "spacing": "0.3rem",
    "duration-fast": "120",
    "duration-default": "280",
    "duration-slow": "520",
    "ease-default": "cubic-bezier(0.65, 0, 0.35, 1)"
  }
}
