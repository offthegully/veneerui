{
  "$schema": "https://veneerui.dev/schemas/theme-v1.json",
  "name": "Editorial",
  "description": "A literary review in print: rich ink on crisp ivory, a singular oxblood with a midnight-ink companion, hairline rules that box every article instead of soft shadows, sharp near-zero corners, and a dramatic Fraunces display scale over a Source Serif body. Leans on type scale, leading, spacing, and crisp borders.",
  "author": { "id": "veneer", "name": "Veneer Team" },
  "version": "1.1.0",
  "schemaVersion": 1,
  "tags": ["light", "serif", "editorial"],
  "license": "MIT",
  "tokens": {
    "color-primary": "#6f1d1b",
    "color-primary-hover": "#581512",
    "color-primary-active": "#46100e",
    "color-primary-subtle": "#f3e2db",
    "color-accent": "#243a52",
    "color-success": "#3f6212",
    "color-warning": "#9a5b06",
    "color-danger": "#a01b1b",
    "color-info": "#243a52",
    "color-focus-ring": "#6f1d1b",
    "color-surface": "#f7f3ea",
    "color-surface-raised": "#fffefb",
    "color-surface-sunken": "#ece5d6",
    "color-surface-overlay": "#fffefb",
    "color-surface-inverse": "#1b1712",
    "color-text": "#181410",
    "color-text-muted": "#5a534a",
    "color-text-subtle": "#9c9384",
    "color-text-inverse": "#f7f3ea",
    "color-text-on-primary": "#f7f3ea",
    "color-border": "#b0a48c",
    "color-border-strong": "#5c5340",
    "color-border-subtle": "#e3dbc9",
    "radius-sm": "0",
    "radius-md": "2px",
    "radius-lg": "3px",
    "radius-xl": "4px",
    "radius-2xl": "6px",
    "shadow-sm": "none",
    "shadow-md": "0 1px 2px rgb(24 20 16 / 0.05)",
    "shadow-card": "none",
    "shadow-lg": "0 6px 24px -12px rgb(24 20 16 / 0.18)",
    "shadow-xl": "0 10px 36px -14px rgb(24 20 16 / 0.22)",
    "gradient-surface": "linear-gradient(180deg, #f9f5ec 0%, #f2ecdf 100%)",
    "gradient-primary": "linear-gradient(135deg, #6f1d1b 0%, #243a52 100%)",
    "gradient-accent": "linear-gradient(135deg, #243a52 0%, #6f1d1b 100%)",
    "gradient-text": "linear-gradient(135deg, #6f1d1b 0%, #243a52 100%)",
    "font-sans": "'Source Serif 4 Variable', serif",
    "font-serif": "'Source Serif 4 Variable', serif",
    "font-display": "'Fraunces Variable', serif",
    "text-sm": "15px",
    "text-base": "18px",
    "text-lg": "20px",
    "text-xl": "24px",
    "text-2xl": "28px",
    "text-3xl": "34px",
    "text-4xl": "46px",
    "text-5xl": "58px",
    "text-6xl": "74px",
    "text-7xl": "90px",
    "text-8xl": "112px",
    "text-9xl": "150px",
    "font-weight-extrabold": "800",
    "leading-tight": "1.1",
    "leading-normal": "1.6",
    "leading-relaxed": "1.85",
    "leading-loose": "2.05",
    "tracking-tighter": "-0.045em",
    "tracking-tight": "-0.02em",
    "tracking-widest": "0.3em",
    "spacing": "0.3rem",
    "duration-fast": "120",
    "duration-default": "280",
    "duration-slow": "520",
    "ease-default": "cubic-bezier(0.65, 0, 0.35, 1)"
  }
}
