{
  "$schema": "https://veneer.app/schemas/theme-v1.json",
  "name": "Sharp Minimalist",
  "description": "A precision instrument: near-black on white, a single confident indigo, tight radii, hairline borders, and faint shadows. Inter throughout, dense and high-contrast.",
  "author": { "id": "veneer", "name": "Veneer Team" },
  "version": "1.0.0",
  "schemaVersion": 1,
  "tags": ["light", "minimal", "product"],
  "license": "MIT",
  "tokens": {
    "color-primary": "#5b5bd6",
    "color-primary-hover": "#4f4fcc",
    "color-primary-active": "#4343b8",
    "color-primary-subtle": "#eeeefc",
    "color-accent": "#4f46e5",
    "color-accent-hover": "#4338ca",
    "color-accent-active": "#3730a3",
    "color-success": "#16a34a",
    "color-warning": "#d97706",
    "color-danger": "#dc2626",
    "color-info": "#5b5bd6",
    "color-focus-ring": "#5b5bd6",
    "color-surface": "#ffffff",
    "color-surface-raised": "#ffffff",
    "color-surface-sunken": "#f5f5f5",
    "color-surface-overlay": "#ffffff",
    "color-surface-inverse": "#0a0a0a",
    "color-text": "#0a0a0a",
    "color-text-muted": "#737373",
    "color-text-subtle": "#a3a3a3",
    "color-text-inverse": "#fafafa",
    "color-text-on-primary": "#ffffff",
    "color-border": "#ececec",
    "color-border-strong": "#d4d4d4",
    "color-border-subtle": "#f5f5f5",
    "radius-sm": "3px",
    "radius-md": "6px",
    "radius-lg": "8px",
    "radius-xl": "10px",
    "shadow-sm": "0 1px 2px rgb(10 10 10 / 0.05)",
    "shadow-md": "0 2px 8px -2px rgb(10 10 10 / 0.08)",
    "shadow-lg": "0 8px 24px -6px rgb(10 10 10 / 0.10)",
    "shadow-card": "0 1px 2px rgb(10 10 10 / 0.05)",
    "text-base": "15px",
    "tracking-tighter": "-0.045em",
    "tracking-tight": "-0.025em",
    "leading-tight": "1.2",
    "leading-normal": "1.5"
  }
}
