{
  "$schema": "https://veneer.app/schemas/theme-v1.json",
  "name": "Midnight",
  "description": "A proper dark theme. Raised surfaces are lighter than the base (not darker), shadows go deep and soft, accents stay bright enough to read on near-black.",
  "author": { "id": "veneer", "name": "Veneer Team" },
  "version": "1.0.0",
  "schemaVersion": 1,
  "tags": ["dark", "blue"],
  "license": "MIT",
  "tokens": {
    "color-primary": "#60a5fa",
    "color-primary-hover": "#93c5fd",
    "color-primary-active": "#bfdbfe",
    "color-primary-subtle": "#1e3a8a",
    "color-accent": "#22d3ee",
    "color-accent-hover": "#67e8f9",
    "color-success": "#4ade80",
    "color-warning": "#fbbf24",
    "color-danger": "#f87171",
    "color-info": "#38bdf8",
    "color-focus-ring": "#60a5fa",
    "color-surface": "#0b1120",
    "color-surface-raised": "#131c31",
    "color-surface-sunken": "#060912",
    "color-surface-overlay": "#1a2540",
    "color-surface-inverse": "#f8fafc",
    "color-text": "#e2e8f0",
    "color-text-muted": "#94a3b8",
    "color-text-subtle": "#64748b",
    "color-text-inverse": "#0b1120",
    "color-text-on-primary": "#0b1120",
    "color-border": "#243049",
    "color-border-strong": "#334155",
    "color-border-subtle": "#1a2336",
    "radius-sm": "4px",
    "radius-md": "8px",
    "radius-lg": "12px",
    "shadow-sm": "0 1px 2px 0 rgb(0 0 0 / 0.4)",
    "shadow-md": "0 4px 10px -2px rgb(0 0 0 / 0.5)",
    "shadow-lg": "0 12px 28px -6px rgb(0 0 0 / 0.6)",
    "shadow-card": "0 2px 8px 0 rgb(0 0 0 / 0.5)",
    "gradient-primary": "linear-gradient(135deg, #60a5fa 0%, #22d3ee 100%)",
    "font-sans": "'Inter Variable', system-ui, sans-serif",
    "font-display": "'Inter Variable', system-ui, sans-serif"
  }
}
