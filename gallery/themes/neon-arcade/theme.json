{
  "$schema": "https://veneer.app/schemas/theme-v1.json",
  "name": "Neon Arcade",
  "description": "Synthwave on near-black: hot-magenta and cyan neon, glowing text, gradient headlines, and an Archivo Black display face. Leans on text-shadow-glow and the gradient set.",
  "author": { "id": "veneer", "name": "Veneer Team" },
  "version": "1.0.0",
  "schemaVersion": 1,
  "tags": ["dark", "neon", "retro", "synthwave"],
  "license": "MIT",
  "tokens": {
    "color-primary": "#ff2bd6",
    "color-primary-hover": "#ff5ce0",
    "color-primary-active": "#e016bf",
    "color-primary-subtle": "rgb(255 43 214 / 0.18)",
    "color-accent": "#00f0ff",
    "color-accent-hover": "#5cf6ff",
    "color-accent-active": "#00c8d6",
    "color-success": "#39ff14",
    "color-warning": "#ffd000",
    "color-danger": "#ff3b6b",
    "color-info": "#00f0ff",
    "color-focus-ring": "#00f0ff",
    "color-surface": "#0a0118",
    "color-surface-raised": "#160a2e",
    "color-surface-sunken": "#0d0322",
    "color-surface-overlay": "rgb(22 10 46 / 0.9)",
    "color-surface-inverse": "#f5e6ff",
    "color-overlay-backdrop": "rgb(0 0 0 / 0.7)",
    "color-text": "#f5e6ff",
    "color-text-muted": "rgb(245 230 255 / 0.7)",
    "color-text-subtle": "rgb(245 230 255 / 0.45)",
    "color-text-inverse": "#0a0118",
    "color-text-on-primary": "#0a0118",
    "color-border": "rgb(255 43 214 / 0.4)",
    "color-border-strong": "rgb(0 240 255 / 0.5)",
    "color-border-subtle": "rgb(255 255 255 / 0.08)",
    "radius-md": "10px",
    "radius-lg": "14px",
    "radius-xl": "20px",
    "shadow-md": "0 0 0 1px rgb(255 43 214 / 0.3), 0 8px 24px rgb(0 0 0 / 0.5)",
    "shadow-lg": "0 0 0 1px rgb(0 240 255 / 0.3), 0 16px 40px rgb(0 0 0 / 0.6)",
    "shadow-card": "0 0 0 1px rgb(255 43 214 / 0.3), 0 8px 24px rgb(0 0 0 / 0.5)",
    "shadow-glow": "0 0 24px rgb(255 43 214 / 0.6)",
    "text-shadow-md": "0 0 6px rgb(255 43 214 / 0.6)",
    "text-shadow-lg": "0 0 10px rgb(255 43 214 / 0.7)",
    "text-shadow-glow": "0 0 10px rgb(0 240 255 / 0.9), 0 0 24px rgb(255 43 214 / 0.7)",
    "drop-shadow-lg": "0 0 16px rgb(0 240 255 / 0.5)",
    "gradient-primary": "linear-gradient(135deg, #ff2bd6 0%, #00f0ff 100%)",
    "gradient-accent": "linear-gradient(135deg, #7c3aed 0%, #00f0ff 100%)",
    "gradient-surface": "linear-gradient(180deg, #160a2e 0%, #0a0118 100%)",
    "gradient-text": "linear-gradient(135deg, #ff2bd6 0%, #00f0ff 100%)",
    "font-display": "'Archivo Black', system-ui, sans-serif",
    "font-weight-bold": "700",
    "font-weight-black": "900",
    "tracking-widest": "0.3em",
    "duration-default": "120",
    "ease-default": "cubic-bezier(0.2, 0, 0, 1)"
  }
}
