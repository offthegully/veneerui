{
  "$schema": "https://veneer.app/schemas/theme-v1.json",
  "name": "Monospaced",
  "description": "A plain-text reader: IBM Plex Mono everywhere on warm amber paper, a burnt-amber primary with a moss-green accent, near-square corners, flat hairline elevation, and neutralized tracking. A light, papery counterpart to the dark Terminal theme.",
  "author": { "id": "veneer", "name": "Veneer Team" },
  "version": "1.0.0",
  "schemaVersion": 1,
  "tags": ["light", "mono", "warm"],
  "license": "MIT",
  "tokens": {
    "color-primary": "#b85c1e",
    "color-primary-hover": "#9c4d18",
    "color-primary-active": "#854114",
    "color-primary-subtle": "#efe0c0",
    "color-accent": "#3a6b3a",
    "color-accent-hover": "#2f592f",
    "color-accent-active": "#264826",
    "color-success": "#3a6b3a",
    "color-warning": "#a16207",
    "color-danger": "#a8331e",
    "color-info": "#3a6b3a",
    "color-focus-ring": "#b85c1e",
    "color-surface": "#f4ecd8",
    "color-surface-raised": "#f6efde",
    "color-surface-sunken": "#ebe0c2",
    "color-surface-overlay": "#f6efde",
    "color-surface-inverse": "#1a1611",
    "color-text": "#1a1611",
    "color-text-muted": "#7a6948",
    "color-text-subtle": "#a08d63",
    "color-text-inverse": "#f4ecd8",
    "color-text-on-primary": "#fbf4e4",
    "color-border": "#cdbf95",
    "color-border-strong": "#bdac7d",
    "color-border-subtle": "#dfd2a8",
    "radius-sm": "2px",
    "radius-md": "2px",
    "radius-lg": "3px",
    "shadow-sm": "0 1px 0 rgb(26 22 17 / 0.10)",
    "shadow-md": "0 2px 0 rgb(26 22 17 / 0.12)",
    "shadow-card": "0 1px 0 rgb(26 22 17 / 0.10)",
    "font-sans": "'IBM Plex Mono', ui-monospace, monospace",
    "font-serif": "'IBM Plex Mono', ui-monospace, monospace",
    "font-mono": "'IBM Plex Mono', ui-monospace, monospace",
    "font-display": "'IBM Plex Mono', ui-monospace, monospace",
    "text-base": "15px",
    "leading-normal": "1.6",
    "leading-relaxed": "1.75",
    "tracking-tighter": "0em",
    "tracking-tight": "0em",
    "duration-fast": "50",
    "duration-default": "110",
    "duration-slow": "200",
    "ease-default": "linear",
    "ease-snappy": "linear"
  }
}
