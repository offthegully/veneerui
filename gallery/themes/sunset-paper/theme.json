{
  "$schema": "https://veneerui.dev/schemas/theme-v1.json",
  "name": "Sunset Paper",
  "description": "Warm and friendly: cream paper surfaces, a sunset orange→raspberry gradient, rounded corners, soft shadows, a Fraunces display face, and a playful overshoot easing.",
  "author": { "id": "veneer", "name": "Veneer Team" },
  "version": "1.0.0",
  "schemaVersion": 1,
  "tags": ["light", "warm", "playful"],
  "license": "MIT",
  "tokens": {
    "color-primary": "#e85d04",
    "color-primary-hover": "#dc5200",
    "color-primary-active": "#c44700",
    "color-primary-subtle": "#ffe9d6",
    "color-accent": "#d6336c",
    "color-accent-hover": "#c02659",
    "color-success": "#2b9348",
    "color-warning": "#f9a826",
    "color-danger": "#d00000",
    "color-info": "#4361ee",
    "color-focus-ring": "#e85d04",
    "color-surface": "#fdf6ec",
    "color-surface-raised": "#fffaf2",
    "color-surface-sunken": "#f5ebda",
    "color-surface-overlay": "#fffaf2",
    "color-surface-inverse": "#3a2d22",
    "color-text": "#3a2d22",
    "color-text-muted": "#6f5d4e",
    "color-text-subtle": "#a08b78",
    "color-text-inverse": "#fdf6ec",
    "color-text-on-primary": "#fffaf2",
    "color-border": "#e8d9c3",
    "color-border-strong": "#d4c0a3",
    "color-border-subtle": "#f0e6d6",
    "radius-sm": "8px",
    "radius-md": "14px",
    "radius-lg": "20px",
    "radius-xl": "28px",
    "shadow-sm": "0 1px 3px rgb(58 45 34 / 0.08)",
    "shadow-md": "0 4px 14px rgb(58 45 34 / 0.12)",
    "shadow-lg": "0 12px 30px -8px rgb(58 45 34 / 0.2)",
    "shadow-card": "0 4px 14px rgb(58 45 34 / 0.12)",
    "gradient-primary": "linear-gradient(135deg, #e85d04 0%, #d6336c 100%)",
    "font-sans": "'Inter Variable', system-ui, sans-serif",
    "font-display": "'Fraunces Variable', serif",
    "duration-default": "240",
    "ease-default": "cubic-bezier(0.34, 1.56, 0.64, 1)",
    "ease-bounce": "cubic-bezier(0.68, -0.55, 0.27, 1.55)"
  }
}
