{
  "$schema": "https://veneer.app/schemas/theme-v1.json",
  "name": "Glassmorphic",
  "description": "Frosted glass over a deep violet base: translucent raised surfaces, hairline white borders, heavy backdrop blur, a violet→fuchsia gradient. Best with blurred panels.",
  "author": { "id": "veneer", "name": "Veneer Team" },
  "version": "1.0.0",
  "schemaVersion": 1,
  "tags": ["dark", "glass", "translucent"],
  "license": "MIT",
  "tokens": {
    "color-primary": "#a78bfa",
    "color-primary-hover": "#c4b5fd",
    "color-primary-active": "#ddd6fe",
    "color-primary-subtle": "rgb(167 139 250 / 0.18)",
    "color-accent": "#f0abfc",
    "color-success": "#6ee7b7",
    "color-warning": "#fcd34d",
    "color-danger": "#fda4af",
    "color-info": "#7dd3fc",
    "color-focus-ring": "#c4b5fd",
    "color-surface": "#11091f",
    "color-surface-raised": "rgb(255 255 255 / 0.08)",
    "color-surface-sunken": "rgb(255 255 255 / 0.04)",
    "color-surface-overlay": "rgb(38 22 64 / 0.85)",
    "color-surface-inverse": "#f5f3ff",
    "color-text": "#f5f3ff",
    "color-text-muted": "rgb(245 243 255 / 0.7)",
    "color-text-subtle": "rgb(245 243 255 / 0.45)",
    "color-text-inverse": "#11091f",
    "color-text-on-primary": "#1a1730",
    "color-border": "rgb(255 255 255 / 0.18)",
    "color-border-strong": "rgb(255 255 255 / 0.3)",
    "color-border-subtle": "rgb(255 255 255 / 0.1)",
    "radius-sm": "10px",
    "radius-md": "16px",
    "radius-lg": "20px",
    "radius-xl": "28px",
    "blur-sm": "10px",
    "blur-md": "16px",
    "blur-lg": "24px",
    "blur-xl": "32px",
    "blur-2xl": "48px",
    "shadow-sm": "0 2px 12px rgb(0 0 0 / 0.25)",
    "shadow-md": "0 6px 24px rgb(0 0 0 / 0.32)",
    "shadow-lg": "0 12px 40px rgb(0 0 0 / 0.4)",
    "shadow-card": "0 8px 32px rgb(0 0 0 / 0.37)",
    "drop-shadow-md": "0 6px 16px rgb(0 0 0 / 0.4)",
    "drop-shadow-lg": "0 16px 40px rgb(0 0 0 / 0.5)",
    "gradient-primary": "linear-gradient(135deg, #a78bfa 0%, #f0abfc 100%)",
    "gradient-accent": "linear-gradient(135deg, #818cf8 0%, #f0abfc 100%)",
    "font-sans": "'Inter Variable', system-ui, sans-serif",
    "font-display": "'Inter Variable', system-ui, sans-serif"
  }
}
