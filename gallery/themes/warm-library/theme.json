{
  "$schema": "https://veneerui.dev/schemas/theme-v1.json",
  "name": "Warm Library",
  "description": "A cozy reading room: EB Garamond for everything (chrome included), antique-cream paper, a muted-terracotta primary with a sage accent, an enlarged type scale, and generous leading.",
  "author": { "id": "veneer", "name": "Veneer Team" },
  "version": "1.0.0",
  "schemaVersion": 1,
  "tags": ["light", "serif", "reading", "warm"],
  "license": "MIT",
  "tokens": {
    "color-primary": "#9c4a2a",
    "color-primary-hover": "#823c22",
    "color-primary-active": "#6e331d",
    "color-primary-subtle": "#f1e3d2",
    "color-accent": "#5e6e4b",
    "color-accent-hover": "#4d5a3d",
    "color-accent-active": "#3f4a32",
    "color-success": "#5e6e4b",
    "color-success-hover": "#515f41",
    "color-success-active": "#444f36",
    "color-success-subtle": "#e8ebe6",
    "color-warning": "#a16207",
    "color-warning-hover": "#8a5406",
    "color-warning-active": "#744705",
    "color-warning-subtle": "#f2e9dc",
    "color-danger": "#9c2a2a",
    "color-danger-hover": "#862424",
    "color-danger-active": "#701e1e",
    "color-danger-subtle": "#f1e1e1",
    "color-info": "#5e6e4b",
    "color-info-hover": "#515f41",
    "color-info-active": "#444f36",
    "color-info-subtle": "#e8ebe6",
    "color-focus-ring": "#9c4a2a",
    "color-surface": "#f5ecd9",
    "color-surface-raised": "#f8f0dc",
    "color-surface-sunken": "#ede2c8",
    "color-surface-overlay": "#fbf3df",
    "color-surface-inverse": "#2b211a",
    "color-text": "#2b211a",
    "color-text-muted": "#74603e",
    "color-text-subtle": "#8c7857",
    "color-text-inverse": "#f5ecd9",
    "color-text-on-primary": "#fbf2dd",
    "color-text-on-accent": "#fbf2dd",
    "color-text-on-success": "#ffffff",
    "color-text-on-warning": "#ffffff",
    "color-text-on-info": "#ffffff",
    "color-border": "#d8c6a2",
    "color-border-strong": "#c4b48c",
    "color-border-subtle": "#e6d8b8",
    "radius-sm": "2px",
    "radius-md": "3px",
    "radius-lg": "4px",
    "shadow-sm": "0 1px 2px rgb(80 50 20 / 0.08)",
    "shadow-md": "0 6px 16px -6px rgb(80 50 20 / 0.16)",
    "shadow-card": "0 1px 3px rgb(80 50 20 / 0.10)",
    "font-sans": "'EB Garamond Variable', serif",
    "font-serif": "'EB Garamond Variable', serif",
    "font-display": "'EB Garamond Variable', serif",
    "text-base": "18px",
    "text-lg": "20px",
    "text-xl": "24px",
    "text-2xl": "28px",
    "text-3xl": "34px",
    "text-4xl": "42px",
    "text-5xl": "54px",
    "text-6xl": "66px",
    "text-7xl": "82px",
    "leading-normal": "1.7",
    "leading-relaxed": "1.85",
    "tracking-tight": "-0.01em",
    "spacing": "0.27rem",
    "duration-fast": "100",
    "duration-default": "260",
    "duration-slow": "480",
    "ease-default": "cubic-bezier(0.33, 0, 0.2, 1)"
  }
}
